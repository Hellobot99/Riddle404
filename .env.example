# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 들어 있어 GitHub에 올라가지 않습니다. 키는 .env에만 넣으세요.

# Google AI Studio에서 발급: https://aistudio.google.com/apikey
# 비워 두면 AI 없이 기본 사건 문장으로 돌아가는 테스트 모드로 실행됩니다.
# AI는 사건을 미리 만들 때만 부르고, 게임 중이나 결과 화면에서는 부르지 않습니다.
GEMINI_API_KEY=

# (선택) 사건 문장 생성 모델. 실패하면 gemini-flash-lite-latest로 대체
# GEMINI_MODEL=gemini-flash-latest

# (선택) 서버 포트
# PORT=3000

# (선택) 진행 시간(초): 브리핑, 루프마다 배치 시간, 투표 시간
# BRIEF_SECONDS=60
# PLAN_SECONDS=90
# VOTE_SECONDS=30
# 마지막 재생 뒤 최종 고발 전 검토 시간(초)
# REVIEW_SECONDS=60

# (선택) 재생 횟수(루프 수)
# LOOPS=7

# (선택) 미리 만들어 두는 사건 수
# CASE_POOL=3

# (선택) 남용 방지: 동시에 열 수 있는 방 수, IP당 10분에 만들 수 있는 방 수
# MAX_ROOMS=200
# CREATE_LIMIT=5
# 리버스 프록시(Render, Nginx 등) 뒤에서 돌릴 때 실제 IP를 쓰려면 1
# TRUST_PROXY=1

# (선택) Render 무료 플랜에서 잠들지 않게 10분마다 자기 주소의 /healthz를 부른다 (Render가 주는 RENDER_EXTERNAL_URL을 쓴다)
# KEEP_AWAKE=1
